[Unit]
Description=Ducksecrets
After=network-online.target
Wants=network-online.target

[Service]
User=ducksecrets
Group=ducksecrets
WorkingDirectory=/var/lib/ducksecrets
ExecStart=/usr/local/bin/ducksecretsd serve
EnvironmentFile=-/etc/ducksecrets/env
Restart=on-failure
# hardening
UMask=0077
# Note on PAM rotation / dynamic access: running unprivileged with
# NoNewPrivileges=true and ProtectSystem=strict is incompatible with the `pam`
# driver's `local` mode (useradd/chpasswd/shadow modifications require root).
# For PAM automation under hardened systemd, use the `pam` driver in `command`
# mode (or delegate to a dedicated privileged helper/site worker).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/ducksecrets
StateDirectory=ducksecrets

[Install]
WantedBy=multi-user.target
