<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="Ducksecrets"
    Language="1033"
    Version="$(var.MsiVersion)"
    Manufacturer="Ducksecrets"
    UpgradeCode="a7b9f3c2-4e81-4d62-9f0a-1c3e5b7d9a01">

    <Package
      InstallerVersion="400"
      Compressed="yes"
      InstallScope="perMachine"
      Description="Ducksecrets CLI and server daemon"
      Comments="Apache-2.0 License" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of Ducksecrets is already installed." />

    <Media Id="1" Cabinet="ducksecrets.cab" EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="DuckSecrets">
          <Component Id="DucksecretsBinaries" Guid="c4d8e2a1-7b39-4f10-8a5c-2e6f4d8b1023" Win64="yes">
            <File Id="DucksecretsCLI" Name="ducksecrets.exe" Source="$(var.DistDir)/ducksecrets-windows-amd64.exe" KeyPath="yes" />
            <File Id="DucksecretsDaemon" Name="ducksecretsd.exe" Source="$(var.DistDir)/ducksecretsd-windows-amd64.exe" />
            <File Id="LicenseFile" Name="LICENSE.txt" Source="LICENSE" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="ProductFeature" Title="Ducksecrets" Level="1">
      <ComponentRef Id="DucksecretsBinaries" />
    </Feature>
  </Product>
</Wix>
